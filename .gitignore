# Python
__pycache__/
*.py[cod]

# Virtual envs (generic)
.venv/
venv/
env/
ENV/

# Your env folder (ignore only venv-like parts so real code named IF_module won’t be ignored)
IF_module/bin/
IF_module/lib/
IF_module/include/
IF_module/pyvenv.cfg
IF_module/Lib/
IF_module/Scripts/
IF_module/Include/
IF_module/share/

# IDE
.idea/
.vscode/
*.iml

# Logs
*.log
app_routes.log

# Env / secrets
.env
.env.*
env_vars.txt

# Data / outputs
downloads/
estimated_OGM/

# Keep common case-study/data artifact formats trackable, even under ignored
# output folders. Other generated files in those folders remain ignored.
!downloads/
!downloads/**/
!downloads/**/*.tif
!downloads/**/*.tiff
!downloads/**/*.geotif
!downloads/**/*.geotiff
!downloads/**/*.json
!downloads/**/*.geojson
!downloads/**/*.png
!downloads/**/*.jpg
!downloads/**/*.jpeg
!downloads/**/*.csv
!downloads/**/*.xml
!estimated_OGM/
!estimated_OGM/**/
!estimated_OGM/**/*.tif
!estimated_OGM/**/*.tiff
!estimated_OGM/**/*.geotif
